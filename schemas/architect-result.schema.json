{
  "$defs": {
    "Task": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "risk_class": {
          "enum": [
            "read_only",
            "workspace_write",
            "staging",
            "production"
          ],
          "title": "Risk Class",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "title",
        "description",
        "acceptance_criteria",
        "depends_on",
        "risk_class"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "summary",
    "tasks"
  ],
  "title": "Plan",
  "type": "object"
}
