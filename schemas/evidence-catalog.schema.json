{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "test",
            "review",
            "handoff",
            "log",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "kind"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Issue Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "interrupted",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "base_commit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Commit"
        },
        "worktree": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worktree"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "issue_id",
        "provider",
        "outcome",
        "ended_at"
      ],
      "title": "Run",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/Run"
      },
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "runs"
  ],
  "title": "Catalog",
  "type": "object"
}
